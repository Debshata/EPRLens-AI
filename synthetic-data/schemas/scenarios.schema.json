{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eprlens.example/schemas/scenarios.schema.json",
  "title": "What-if scenario inputs",
  "description": "SYNTHETIC — EPRLens Demo. PROPOSED schema; see docs/DECISIONS-REQUIRED.md.",
  "x-schema-version": "0.2.0",
  "x-primary-key": "scenario_id",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "company_id",
    "product_id",
    "baseline_weight_g",
    "proposed_weight_g",
    "units",
    "baseline_kg",
    "proposed_kg",
    "projected_reduction_kg",
    "assumptions",
    "synthetic_flag"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "description": "Id",
      "pattern": "^SCN_\\d{6}$",
      "x-provenance": "M"
    },
    "company_id": {
      "type": "string",
      "description": "Company",
      "pattern": "^COMP_\\d{4}$",
      "x-provenance": "M",
      "x-foreign-key": "companies.company_id"
    },
    "product_id": {
      "type": "string",
      "description": "Product",
      "pattern": "^PROD_(\\d{6}|TEST_\\d{3})$",
      "x-provenance": "M",
      "x-foreign-key": "products.product_id"
    },
    "baseline_weight_g": {
      "type": "number",
      "description": "Weight in force",
      "minimum": 0,
      "x-provenance": "E"
    },
    "proposed_weight_g": {
      "type": "number",
      "description": "Proposed weight",
      "minimum": 0,
      "x-provenance": "E"
    },
    "units": {
      "type": "integer",
      "description": "Units basis",
      "minimum": 0,
      "x-provenance": "E"
    },
    "baseline_kg": {
      "type": "number",
      "description": "units × baseline g / 1000",
      "x-provenance": "E"
    },
    "proposed_kg": {
      "type": "number",
      "description": "units × proposed g / 1000",
      "x-provenance": "E"
    },
    "projected_reduction_kg": {
      "type": "number",
      "description": "baseline − proposed",
      "x-provenance": "E"
    },
    "assumptions": {
      "type": "string",
      "description": "Plain-text assumptions",
      "x-provenance": "E"
    },
    "synthetic_flag": {
      "type": "boolean",
      "description": "Always true. SYNTHETIC — EPRLens Demo.",
      "enum": [
        true
      ],
      "x-provenance": "M"
    }
  }
}
