{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eprlens.example/schemas/transactions.schema.json",
  "title": "Internal transaction records (CSV upload format)",
  "description": "SYNTHETIC — EPRLens Demo. PROPOSED schema; see docs/DECISIONS-REQUIRED.md.",
  "x-schema-version": "0.2.0",
  "x-primary-key": "transaction_id",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "transaction_id",
    "company_id",
    "date",
    "transaction_type",
    "state",
    "raw_quantity",
    "raw_unit",
    "status",
    "synthetic_flag"
  ],
  "properties": {
    "transaction_id": {
      "type": "string",
      "description": "Id",
      "pattern": "^TXN_\\d{8}$",
      "x-provenance": "M"
    },
    "company_id": {
      "type": "string",
      "description": "Company",
      "pattern": "^COMP_\\d{4}$",
      "x-provenance": "M",
      "x-foreign-key": "companies.company_id"
    },
    "product_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Product (sales)",
      "pattern": "^PROD_(\\d{6}|TEST_\\d{3})$",
      "x-provenance": "M",
      "x-foreign-key": "products.product_id"
    },
    "component_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Component (purchases)",
      "pattern": "^PKGCOMP_\\d{6}$",
      "x-provenance": "M",
      "x-foreign-key": "packaging_components.component_id"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date",
      "x-provenance": "M"
    },
    "transaction_type": {
      "type": "string",
      "description": "Type",
      "enum": [
        "sale",
        "purchase",
        "import",
        "return",
        "export_sale",
        "credit_adjustment"
      ],
      "x-provenance": "E"
    },
    "units": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Units / pieces",
      "minimum": 0,
      "x-provenance": "E"
    },
    "state": {
      "type": "string",
      "description": "State of sale/receipt (state-wise reporting, handbook p.42)",
      "x-provenance": "H"
    },
    "buyer_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Buyer",
      "pattern": "^BUY_(\\d{4}|TEST_\\d{3})$",
      "x-provenance": "M",
      "x-foreign-key": "buyers.buyer_id"
    },
    "buyer_epr_registered": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Liability-shift input (p.42)",
      "x-provenance": "H"
    },
    "supplier_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Supplier",
      "pattern": "^SUP_(\\d{4}|TEST_\\d{3})$",
      "x-provenance": "M",
      "x-foreign-key": "suppliers.supplier_id"
    },
    "raw_quantity": {
      "type": "number",
      "description": "As recorded",
      "x-provenance": "E"
    },
    "raw_unit": {
      "type": "string",
      "description": "As recorded",
      "enum": [
        "kg",
        "g",
        "MT",
        "pcs",
        "cartons",
        "bottles",
        "bags",
        "rolls"
      ],
      "x-provenance": "E"
    },
    "normalized_quantity_kg": {
      "type": [
        "number",
        "null"
      ],
      "description": "Packaging kg; null if unconvertible",
      "x-provenance": "E"
    },
    "plastic_kg": {
      "type": [
        "number",
        "null"
      ],
      "description": "Plastic-relevant subset",
      "x-provenance": "E"
    },
    "invoice_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Linked invoice",
      "pattern": "^INV_\\d{8}$",
      "x-provenance": "M",
      "x-foreign-key": "invoices.invoice_id"
    },
    "status": {
      "type": "string",
      "description": "posted | cancelled",
      "enum": [
        "posted",
        "cancelled"
      ],
      "x-provenance": "E"
    },
    "synthetic_flag": {
      "type": "boolean",
      "description": "Always true. SYNTHETIC — EPRLens Demo.",
      "enum": [
        true
      ],
      "x-provenance": "M"
    }
  }
}
