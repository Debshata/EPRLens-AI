{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eprlens.example/schemas/material_events.schema.json",
  "title": "Material-flow ledger events",
  "description": "SYNTHETIC — EPRLens Demo. PROPOSED schema; see docs/DECISIONS-REQUIRED.md.",
  "x-schema-version": "0.2.0",
  "x-primary-key": "event_id",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "company_id",
    "component_id",
    "material",
    "synthetic_category",
    "event_type",
    "date",
    "period",
    "kg",
    "direction",
    "status",
    "synthetic_flag"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Id",
      "pattern": "^MEV_\\d{9}$",
      "x-provenance": "M"
    },
    "company_id": {
      "type": "string",
      "description": "Company",
      "pattern": "^COMP_\\d{4}$",
      "x-provenance": "M",
      "x-foreign-key": "companies.company_id"
    },
    "product_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Product",
      "pattern": "^PROD_(\\d{6}|TEST_\\d{3})$",
      "x-provenance": "M",
      "x-foreign-key": "products.product_id"
    },
    "component_id": {
      "type": "string",
      "description": "Component",
      "pattern": "^PKGCOMP_\\d{6}$",
      "x-provenance": "M",
      "x-foreign-key": "packaging_components.component_id"
    },
    "material": {
      "type": "string",
      "description": "Material",
      "enum": [
        "PET",
        "HDPE",
        "LDPE",
        "LLDPE",
        "PP",
        "PVC",
        "PS",
        "MLP",
        "COMPOSTABLE",
        "PAPER",
        "CARDBOARD",
        "GLASS",
        "METAL",
        "BATTERY",
        "OTHER"
      ],
      "x-provenance": "E"
    },
    "synthetic_category": {
      "type": "string",
      "description": "Synthetic category convention",
      "enum": [
        "CAT_I",
        "CAT_II",
        "CAT_III",
        "CAT_IV",
        "NA",
        "UNKNOWN"
      ],
      "x-provenance": "E"
    },
    "event_type": {
      "type": "string",
      "description": "Event type",
      "enum": [
        "OPENING_BALANCE",
        "PURCHASED",
        "PRODUCED",
        "CONSUMED",
        "WRITTEN_OFF",
        "PLACED_ON_MARKET",
        "RETURNED",
        "EXPORTED",
        "WASTE_GENERATED_PROXY",
        "COLLECTED",
        "RECYCLED",
        "CREDITS_DOCUMENTED",
        "CLOSING_BALANCE"
      ],
      "x-provenance": "E"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date",
      "x-provenance": "M"
    },
    "period": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$",
      "description": "YYYY-MM",
      "x-provenance": "M"
    },
    "kg": {
      "type": "number",
      "description": "Mass (≥0)",
      "minimum": 0,
      "x-provenance": "E"
    },
    "direction": {
      "type": "string",
      "description": "in | out | memo",
      "enum": [
        "in",
        "out",
        "memo"
      ],
      "x-provenance": "E"
    },
    "source_document_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Evidence",
      "x-provenance": "M"
    },
    "source_line_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Evidence line",
      "x-provenance": "M"
    },
    "counterparty_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Counterparty",
      "pattern": "^(COMP_\\d{4}|SUP_(\\d{4}|TEST_\\d{3})|BUY_(\\d{4}|TEST_\\d{3})|REC_(\\d{4}|TEST_\\d{3}))$",
      "x-provenance": "M"
    },
    "status": {
      "type": "string",
      "description": "Evidence status",
      "enum": [
        "document_supported",
        "estimated",
        "declared",
        "unknown",
        "cancelled"
      ],
      "x-provenance": "E"
    },
    "supersedes_event_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Correction chain",
      "x-provenance": "M"
    },
    "synthetic_flag": {
      "type": "boolean",
      "description": "Always true. SYNTHETIC — EPRLens Demo.",
      "enum": [
        true
      ],
      "x-provenance": "M"
    }
  }
}
