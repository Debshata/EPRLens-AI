{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eprlens.example/schemas/addresses.schema.json",
  "title": "Fictional address master",
  "description": "SYNTHETIC — EPRLens Demo. PROPOSED schema; see docs/DECISIONS-REQUIRED.md.",
  "x-schema-version": "0.2.0",
  "x-primary-key": "address_id",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "address_id",
    "entity_type",
    "entity_id",
    "address_kind",
    "address_line_1",
    "address_line_2",
    "city",
    "state",
    "state_code",
    "postal_code",
    "country",
    "synthetic_flag"
  ],
  "properties": {
    "address_id": {
      "type": "string",
      "description": "Address id",
      "pattern": "^ADDR_\\d{6}$",
      "x-provenance": "M"
    },
    "entity_type": {
      "type": "string",
      "description": "Owner type",
      "enum": [
        "company",
        "supplier",
        "buyer",
        "recycler"
      ],
      "x-provenance": "M"
    },
    "entity_id": {
      "type": "string",
      "description": "Owner id",
      "pattern": "^(COMP_\\d{4}|SUP_(\\d{4}|TEST_\\d{3})|BUY_(\\d{4}|TEST_\\d{3})|REC_(\\d{4}|TEST_\\d{3}))$",
      "x-provenance": "M"
    },
    "address_kind": {
      "type": "string",
      "description": "hq | plant | warehouse",
      "enum": [
        "hq",
        "plant",
        "warehouse"
      ],
      "x-provenance": "M"
    },
    "address_line_1": {
      "type": "string",
      "description": "Fictional plot/building",
      "x-provenance": "E"
    },
    "address_line_2": {
      "type": "string",
      "description": "Fictional locality",
      "x-provenance": "E"
    },
    "city": {
      "type": "string",
      "description": "City (real name, for tax logic)",
      "x-provenance": "E"
    },
    "state": {
      "type": "string",
      "description": "State",
      "x-provenance": "E"
    },
    "state_code": {
      "type": "string",
      "description": "GST state code (verify)",
      "pattern": "^\\d{2}$",
      "x-provenance": "E"
    },
    "postal_code": {
      "type": "string",
      "description": "6-digit PIN-like value, region-consistent first digit (DS-17)",
      "pattern": "^[1-8]\\d{5}$",
      "x-provenance": "E"
    },
    "country": {
      "type": "string",
      "description": "Country",
      "enum": [
        "India"
      ],
      "x-provenance": "E"
    },
    "synthetic_flag": {
      "type": "boolean",
      "description": "Always true. SYNTHETIC — EPRLens Demo.",
      "enum": [
        true
      ],
      "x-provenance": "M"
    }
  }
}
