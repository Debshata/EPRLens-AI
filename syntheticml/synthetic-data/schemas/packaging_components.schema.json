{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eprlens.example/schemas/packaging_components.schema.json",
  "title": "Packaging component master (one row per spec version)",
  "description": "SYNTHETIC — EPRLens Demo. PROPOSED schema; see docs/DECISIONS-REQUIRED.md.",
  "x-schema-version": "0.3.0",
  "x-primary-key": "component_id",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component_id",
    "product_id",
    "component_name",
    "component_form",
    "material",
    "synthetic_category",
    "category_basis",
    "category_confidence",
    "legal_verification_status",
    "plastic_epr_relevant",
    "weight_per_unit_g",
    "recycled_content_pct",
    "hsn_code",
    "supplier_id",
    "evidence_reference",
    "spec_version",
    "effective_from",
    "test_entity",
    "synthetic_flag"
  ],
  "properties": {
    "component_id": {
      "type": "string",
      "description": "Component id",
      "pattern": "^PKGCOMP_\\d{6}$",
      "x-provenance": "M"
    },
    "product_id": {
      "type": "string",
      "description": "Product",
      "pattern": "^PROD_(\\d{6}|TEST_\\d{3})$",
      "x-provenance": "M",
      "x-foreign-key": "products.product_id"
    },
    "component_name": {
      "type": "string",
      "description": "e.g. 'PET bottle'",
      "x-provenance": "E"
    },
    "component_form": {
      "type": "string",
      "description": "Physical form used for category declaration",
      "enum": [
        "bottle",
        "jar",
        "cap",
        "closure",
        "tray",
        "drum",
        "tub",
        "pail",
        "preform",
        "eps_block",
        "blister",
        "film",
        "shrink_wrap",
        "stretch_wrap",
        "label_film",
        "bag",
        "mailer",
        "liner",
        "pouch_mono",
        "sachet_mono",
        "pouch_laminate",
        "sachet_laminate",
        "laminated_tube",
        "compostable_bag",
        "compostable_mailer",
        "carton",
        "box",
        "paper_label",
        "glass_bottle",
        "can",
        "void_fill"
      ],
      "x-provenance": "E"
    },
    "material": {
      "type": "string",
      "description": "Material code",
      "enum": [
        "PET",
        "HDPE",
        "LDPE",
        "LLDPE",
        "PP",
        "PVC",
        "PS",
        "MLP",
        "COMPOSTABLE",
        "PAPER",
        "CARDBOARD",
        "GLASS",
        "METAL",
        "BATTERY",
        "OTHER"
      ],
      "x-provenance": "E"
    },
    "synthetic_category": {
      "type": "string",
      "description": "Synthetic modelling convention by component form (DS-09). NOT a legal classification.",
      "enum": [
        "CAT_I",
        "CAT_II",
        "CAT_III",
        "CAT_IV",
        "NA",
        "UNKNOWN"
      ],
      "x-provenance": "E"
    },
    "category_basis": {
      "type": "string",
      "description": "How the synthetic category was set",
      "enum": [
        "synthetic_convention_by_form"
      ],
      "x-provenance": "M"
    },
    "category_confidence": {
      "type": "string",
      "description": "declared | ambiguous",
      "enum": [
        "declared",
        "ambiguous"
      ],
      "x-provenance": "E"
    },
    "legal_verification_status": {
      "type": "string",
      "description": "Legal/official verification of the category (TBD until verified)",
      "enum": [
        "TBD",
        "handbook_named_only",
        "officially_verified"
      ],
      "x-provenance": "M"
    },
    "plastic_epr_relevant": {
      "type": "boolean",
      "description": "Plastic packaging per handbook scope (DS-02)",
      "x-provenance": "H"
    },
    "weight_per_unit_g": {
      "type": "number",
      "description": "Grams per finished unit",
      "minimum": 0,
      "x-provenance": "E"
    },
    "recycled_content_pct": {
      "type": "number",
      "description": "Recycled content %",
      "minimum": 0,
      "maximum": 100,
      "x-provenance": "H"
    },
    "hsn_code": {
      "type": "string",
      "description": "Illustrative HSN heading (TBD verify)",
      "pattern": "^\\d{4,8}$",
      "x-provenance": "E"
    },
    "supplier_id": {
      "type": "string",
      "description": "Primary supplier",
      "pattern": "^SUP_(\\d{4}|TEST_\\d{3})$",
      "x-provenance": "M",
      "x-foreign-key": "suppliers.supplier_id"
    },
    "evidence_reference": {
      "type": "string",
      "description": "Synthetic spec-sheet reference",
      "x-provenance": "M"
    },
    "spec_version": {
      "type": "integer",
      "description": "Spec version (1, 2, …)",
      "minimum": 1,
      "x-provenance": "M"
    },
    "effective_from": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Weight valid from",
      "x-provenance": "E"
    },
    "effective_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Weight valid to (null = current)",
      "x-provenance": "E"
    },
    "test_entity": {
      "type": "boolean",
      "description": "True for deliberately problematic *_TEST_* entities (DS-22/23).",
      "x-provenance": "M"
    },
    "test_scenario": {
      "type": [
        "string",
        "null"
      ],
      "description": "Scenario code (see docs/dummy-entities.md), null for normal entities.",
      "pattern": "^TS\\d{2}_[A-Z0-9_]+$",
      "x-provenance": "M"
    },
    "synthetic_flag": {
      "type": "boolean",
      "description": "Always true. SYNTHETIC — EPRLens Demo.",
      "enum": [
        true
      ],
      "x-provenance": "M"
    }
  }
}
