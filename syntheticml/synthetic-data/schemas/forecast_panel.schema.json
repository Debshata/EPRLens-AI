{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eprlens.example/schemas/forecast_panel.schema.json",
  "title": "Product-month forecasting panel built from the CLEAN world (DS-06)",
  "description": "SYNTHETIC — EPRLens Demo. PROPOSED schema; see docs/DECISIONS-REQUIRED.md.",
  "x-schema-version": "0.3.0",
  "x-primary-key": "product_id",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "company_id",
    "product_id",
    "industry",
    "month",
    "month_num",
    "t_index",
    "units_sold",
    "weight_per_unit_g",
    "packaging_kg",
    "target_month",
    "next_month_packaging_kg",
    "time_split",
    "company_holdout",
    "synthetic_flag"
  ],
  "properties": {
    "company_id": {
      "type": "string",
      "description": "",
      "pattern": "^COMP_\\d{4}$",
      "x-provenance": "M"
    },
    "product_id": {
      "type": "string",
      "description": "",
      "pattern": "^PROD_(\\d{6}|TEST_\\d{3})$",
      "x-provenance": "M"
    },
    "industry": {
      "type": "string",
      "description": "",
      "enum": [
        "Beverages",
        "FMCG",
        "Cosmetics",
        "Personal Care",
        "Food",
        "Pharmaceuticals",
        "Electronics",
        "Appliances",
        "Automotive",
        "Retail",
        "E-commerce",
        "Household Products",
        "Industrial Goods"
      ],
      "x-provenance": "E"
    },
    "month": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$",
      "description": "Forecast origin month",
      "x-provenance": "M"
    },
    "month_num": {
      "type": "integer",
      "description": "1-12",
      "minimum": 1,
      "maximum": 12,
      "x-provenance": "M"
    },
    "t_index": {
      "type": "integer",
      "description": "0-35",
      "minimum": 0,
      "x-provenance": "M"
    },
    "units_sold": {
      "type": "integer",
      "description": "Units in origin month",
      "minimum": 0,
      "x-provenance": "E"
    },
    "weight_per_unit_g": {
      "type": "number",
      "description": "Total packaging g/unit in force",
      "minimum": 0,
      "x-provenance": "E"
    },
    "packaging_kg": {
      "type": "number",
      "description": "Packaging kg in origin month",
      "minimum": 0,
      "x-provenance": "E"
    },
    "lag_1": {
      "type": [
        "number",
        "null"
      ],
      "description": "",
      "x-provenance": "E"
    },
    "lag_2": {
      "type": [
        "number",
        "null"
      ],
      "description": "",
      "x-provenance": "E"
    },
    "lag_3": {
      "type": [
        "number",
        "null"
      ],
      "description": "",
      "x-provenance": "E"
    },
    "lag_6": {
      "type": [
        "number",
        "null"
      ],
      "description": "",
      "x-provenance": "E"
    },
    "lag_12": {
      "type": [
        "number",
        "null"
      ],
      "description": "",
      "x-provenance": "E"
    },
    "rolling_mean_3": {
      "type": [
        "number",
        "null"
      ],
      "description": "Mean of months t-2..t",
      "x-provenance": "E"
    },
    "rolling_mean_6": {
      "type": [
        "number",
        "null"
      ],
      "description": "Mean of months t-5..t",
      "x-provenance": "E"
    },
    "sales_growth": {
      "type": [
        "number",
        "null"
      ],
      "description": "units_t / units_t-1 - 1",
      "x-provenance": "E"
    },
    "seasonality_index": {
      "type": [
        "number",
        "null"
      ],
      "description": "Industry x month index from TRAIN months only",
      "x-provenance": "E"
    },
    "target_month": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$",
      "description": "",
      "x-provenance": "M"
    },
    "next_month_packaging_kg": {
      "type": "number",
      "description": "Target",
      "minimum": 0,
      "x-provenance": "E"
    },
    "time_split": {
      "type": "string",
      "description": "By target month: 24 train / 6 validation / 6 test",
      "enum": [
        "train",
        "validation",
        "test"
      ],
      "x-provenance": "M"
    },
    "company_holdout": {
      "type": "boolean",
      "description": "",
      "x-provenance": "M"
    },
    "synthetic_flag": {
      "type": "boolean",
      "description": "Always true. SYNTHETIC — EPRLens Demo.",
      "enum": [
        true
      ],
      "x-provenance": "M"
    }
  }
}
