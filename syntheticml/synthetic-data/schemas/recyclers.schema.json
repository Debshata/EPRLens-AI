{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eprlens.example/schemas/recyclers.schema.json",
  "title": "Recycler (plastic waste processor) master",
  "description": "SYNTHETIC — EPRLens Demo. PROPOSED schema; see docs/DECISIONS-REQUIRED.md.",
  "x-schema-version": "0.3.0",
  "x-primary-key": "recycler_id",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recycler_id",
    "recycler_name",
    "state",
    "city",
    "hq_address_id",
    "fake_gstin",
    "registered",
    "processing_type",
    "supported_materials",
    "monthly_capacity_kg",
    "test_entity",
    "synthetic_flag"
  ],
  "properties": {
    "recycler_id": {
      "type": "string",
      "description": "Recycler id",
      "pattern": "^REC_(\\d{4}|TEST_\\d{3})$",
      "x-provenance": "M"
    },
    "recycler_name": {
      "type": "string",
      "description": "Fictional name",
      "x-provenance": "E"
    },
    "state": {
      "type": "string",
      "description": "State",
      "x-provenance": "E"
    },
    "city": {
      "type": "string",
      "description": "City",
      "x-provenance": "E"
    },
    "hq_address_id": {
      "type": "string",
      "description": "Address",
      "pattern": "^ADDR_\\d{6}$",
      "x-provenance": "M",
      "x-foreign-key": "addresses.address_id"
    },
    "fake_gstin": {
      "type": "string",
      "description": "GSTIN-like, invalid checksum",
      "pattern": "^\\d{2}[A-Z]{5}\\d{4}[A-Z][1-9A-Z]Z[0-9A-Z]$",
      "x-provenance": "P"
    },
    "registered": {
      "type": "boolean",
      "description": "Registered in the synthetic world (unregistered ones exist for AN13)",
      "x-provenance": "H"
    },
    "fake_registration_number": {
      "type": [
        "string",
        "null"
      ],
      "description": "Fictional SYN-PWP number; does NOT represent a CPCB authorization. For unregistered recyclers it is a *claimed* number",
      "pattern": "^SYN-PWP-[A-Z]{2}-\\d{4}-\\d{4}$",
      "x-provenance": "E"
    },
    "processing_type": {
      "type": "string",
      "description": "Processing type",
      "enum": [
        "PET recycling",
        "HDPE recycling",
        "LDPE recycling",
        "PP recycling",
        "mixed-plastic processing",
        "MLP processing",
        "industrial composting"
      ],
      "x-provenance": "H"
    },
    "supported_materials": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Materials accepted",
      "x-provenance": "E"
    },
    "monthly_capacity_kg": {
      "type": "number",
      "description": "Illustrative capacity",
      "minimum": 0,
      "x-provenance": "E"
    },
    "test_entity": {
      "type": "boolean",
      "description": "True for deliberately problematic *_TEST_* entities (DS-22/23).",
      "x-provenance": "M"
    },
    "test_scenario": {
      "type": [
        "string",
        "null"
      ],
      "description": "Scenario code (see docs/dummy-entities.md), null for normal entities.",
      "pattern": "^TS\\d{2}_[A-Z0-9_]+$",
      "x-provenance": "M"
    },
    "synthetic_flag": {
      "type": "boolean",
      "description": "Always true. SYNTHETIC — EPRLens Demo.",
      "enum": [
        true
      ],
      "x-provenance": "M"
    }
  }
}
