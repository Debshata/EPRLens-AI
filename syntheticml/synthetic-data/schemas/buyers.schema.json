{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eprlens.example/schemas/buyers.schema.json",
  "title": "Customer / buyer master",
  "description": "SYNTHETIC — EPRLens Demo. PROPOSED schema; see docs/DECISIONS-REQUIRED.md.",
  "x-schema-version": "0.3.0",
  "x-primary-key": "buyer_id",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "buyer_id",
    "buyer_name",
    "buyer_type",
    "state",
    "city",
    "hq_address_id",
    "gst_registered",
    "epr_registered",
    "company_size",
    "test_entity",
    "synthetic_flag"
  ],
  "properties": {
    "buyer_id": {
      "type": "string",
      "description": "Buyer id",
      "pattern": "^BUY_(\\d{4}|TEST_\\d{3})$",
      "x-provenance": "M"
    },
    "buyer_name": {
      "type": "string",
      "description": "Fictional name",
      "x-provenance": "E"
    },
    "buyer_type": {
      "type": "string",
      "description": "Type",
      "enum": [
        "distributor",
        "wholesaler",
        "retailer",
        "supermarket",
        "e-commerce seller",
        "institutional buyer",
        "manufacturing customer"
      ],
      "x-provenance": "E"
    },
    "state": {
      "type": "string",
      "description": "State",
      "x-provenance": "E"
    },
    "city": {
      "type": "string",
      "description": "City",
      "x-provenance": "E"
    },
    "hq_address_id": {
      "type": "string",
      "description": "Address",
      "pattern": "^ADDR_\\d{6}$",
      "x-provenance": "M",
      "x-foreign-key": "addresses.address_id"
    },
    "fake_gstin": {
      "type": [
        "string",
        "null"
      ],
      "description": "GSTIN-like; null if not GST-registered; BUY_TEST_001 deliberately malformed",
      "x-provenance": "P"
    },
    "gst_registered": {
      "type": "boolean",
      "description": "GST-registered (kept separate from epr_registered)",
      "x-provenance": "E"
    },
    "epr_registered": {
      "type": "boolean",
      "description": "Declared EPR registration — drives liability shift (handbook p.42, DS-12)",
      "x-provenance": "H"
    },
    "company_size": {
      "type": "string",
      "description": "Size band",
      "enum": [
        "micro",
        "small",
        "medium",
        "large"
      ],
      "x-provenance": "E"
    },
    "test_entity": {
      "type": "boolean",
      "description": "True for deliberately problematic *_TEST_* entities (DS-22/23).",
      "x-provenance": "M"
    },
    "test_scenario": {
      "type": [
        "string",
        "null"
      ],
      "description": "Scenario code (see docs/dummy-entities.md), null for normal entities.",
      "pattern": "^TS\\d{2}_[A-Z0-9_]+$",
      "x-provenance": "M"
    },
    "synthetic_flag": {
      "type": "boolean",
      "description": "Always true. SYNTHETIC — EPRLens Demo.",
      "enum": [
        true
      ],
      "x-provenance": "M"
    }
  }
}
