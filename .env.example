# Variable NAMES only. Real values live in frontend/.env.local (git-ignored) or your shell. Never commit secrets.
AWS_PROFILE=eprlens
AWS_REGION=ap-south-1
PREFIX=eprlens-demo

# Set on each Lambda by infrastructure/scripts/40-deploy.sh:
ANALYSIS_TABLE=
UPLOADS_BUCKET=
MODELS_BUCKET=
MODEL_BUCKET=
REFERENCE_BUCKET=
UNCERTAIN_THRESHOLD=0.60

# Local runs only (backend/run_local.py sets sensible defaults):
LOCAL_SEED_DIR=
LOCAL_STORE_FILE=
