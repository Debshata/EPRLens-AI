# --- Public (safe for the browser) ---
# "mock" (default): fixtures only, no network, no AWS. "live": call the /api/* route handlers.
NEXT_PUBLIC_API_MODE=mock

# --- Server-only (never prefix with NEXT_PUBLIC_; only read by src/app/api/* in live mode) ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
UPLOADS_BUCKET=
LAMBDA_PARSE_INVOICE=
LAMBDA_RECONCILE=
LAMBDA_CLASSIFY_IMAGE=
LAMBDA_FORECAST=
LAMBDA_DETECT_ANOMALY=
LAMBDA_SCENARIO_ENGINE=
# Optional until the backend exposes company profile / dashboard summary / simulator catalogue (see docs/frontend-api-contracts.md)
LAMBDA_COMPANY_DATA=
