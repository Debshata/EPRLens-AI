# Generated full datasets and PDFs stay out of Git history (S3 / release assets instead)
data/
synthetic-data/outputs/*
!synthetic-data/outputs/sample/
# Models and evaluation artefacts produced by runs
ml/models/
*.joblib
*.pkl
*.onnx
# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
# Secrets
.env
.env.*
!.env.example

# ML runs, caches and logs (final metrics/artifacts are copied to ml/evaluation and ml/artifacts)
ml/runs/
ml/logs/
.ipynb_checkpoints/

# Exported model artifacts ARE committed (small: see ml/evaluation/aws_artifact_report.json)
!ml/artifacts/**/*.joblib
!ml/artifacts/**/*.onnx
